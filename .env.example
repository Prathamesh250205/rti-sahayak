# The provider fallback chain generate()/generate_stream() walks, in order - if one
# fails, the next is tried automatically. LLM_PROVIDER sets chain[0] ("the primary");
# the other two configured providers fill in behind it in their default order. Groq is
# the default primary: Gemini's free tier is a hard 20 requests/day, too tight for a
# live demo, and Anthropic (paid, no free-tier daily cap) sits last as the provider an
# outage or throttle can never turn into a hard failure against.
LLM_PROVIDER=groq
# Full explicit override of the chain order (comma-separated, e.g. "anthropic,groq,gemini")
# - set this instead of LLM_PROVIDER to promote Anthropic to primary, or to fully control
# the order rather than relying on the default fill-in behind LLM_PROVIDER's chain[0].
# LLM_PROVIDER_CHAIN=groq,gemini,anthropic

# Groq (primary for the demo) — https://console.groq.com/keys
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=openai/gpt-oss-120b
# Groq's SDK defaults to 2 internal retries on failure (including HTTP 429 - it retries
# rate limits, not just 5xx/connection errors). On a 30 RPM ceiling, one failing logical
# call can silently cost up to 3 real requests. 1 keeps a useful retry-after-backoff
# while capping worst-case cost per call at 2 real requests instead of 3.
# GROQ_MAX_RETRIES=1
# Off by default - logging Groq's rate-limit headers requires a call path
# (with_raw_response.create()) not yet verified against the real API. See llm/client.py.
# GROQ_LOG_RATE_LIMITS=false

# Gemini (fallback) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
# TODO(Gate 12e): gemini-flash-latest is a floating alias, not a stable model - it has
# silently repointed before (gemini-3-flash-preview -> gemini-3.5-flash -> gemini-3.7-flash,
# observed directly in this project with no code change), and each repoint can carry a
# different free-tier quota with zero warning. Pin an explicit, non-"latest" model ID here
# once its actual free-tier RPD is confirmed in the AI Studio rate-limit dashboard (the
# public docs don't publish per-model numbers). Left as the working alias, not a broken
# placeholder - the app must always boot - but web/main.py logs a loud startup WARNING
# every time this is still set to an unpinned "latest" alias.
GEMINI_MODEL=gemini-flash-latest

# Anthropic (last resort - paid, no free-tier daily cap) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-key-here
# claude-haiku-4-5-20251001 - classification/Q&A calls here are small and structured;
# Haiku is fast, cheap, and more than sufficient.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Same reasoning as GROQ_MAX_RETRIES - explicit rather than left at the SDK's default (2).
# ANTHROPIC_MAX_RETRIES=1

# --- Accounts (web/api/auth.py) ---
# Signs the login cookie. Without it a random key is used and everyone is
# logged out on restart. Generate: python -c "import secrets;print(secrets.token_hex(32))"
SESSION_SECRET=
# Secure-only session cookie. Defaults to true on Vercel, false elsewhere.
COOKIE_SECURE=
# Base URL for reset emails and OAuth callbacks. On Vercel it defaults to the
# project's production domain; set it if you use a custom domain.
PUBLIC_BASE_URL=
# Accounts database. Required on Vercel: add a Neon Postgres database under
# the project's Storage tab and Vercel sets this for you. Unset = local SQLite
# file at USERS_DB_PATH (default data/users.db) - fine for local dev.
DATABASE_URL=
USERS_DB_PATH=
# Optional "Continue with Google / GitHub". A button appears only when both
# values for that provider are set. Callback URLs to register:
#   {PUBLIC_BASE_URL}/auth/google/callback   (console.cloud.google.com > Credentials > OAuth client ID, type Web)
#   {PUBLIC_BASE_URL}/auth/github/callback   (github.com/settings/developers > New OAuth App)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional SMTP for reset emails. Unset = the reset link is printed to the server log.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASSWORD=<16-char App Password from myaccount.google.com/apppasswords>.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
