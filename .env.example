# Which provider generate() uses. Swap this if the primary rate-limits during the demo.
# Groq is the default: Gemini's free tier is a hard 20 requests/day, too tight for a live demo.
LLM_PROVIDER=groq

# Groq (primary for the demo) — https://console.groq.com/keys
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=openai/gpt-oss-120b

# Gemini (fallback) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-flash-latest
