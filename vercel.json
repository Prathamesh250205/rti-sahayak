{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python -m tools.vercel_build",
  "functions": {
    "index.py": {
      "maxDuration": 60,
      "excludeFiles": "{.venv/**,**/node_modules/**,design/**,docs/**,tools/**,data/corpus/**}"
    }
  },
  "headers": [
    {
      "source": "/static/(.*)",
      "has": [{ "type": "query", "key": "v" }],
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/static/vendor/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
